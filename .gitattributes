# Auto detect text files and perform LF normalization
* text=auto

# dist/index.html is generated by tools/build.py. Marking it generated keeps a
# 280 KB machine-written diff from burying the real change in every review, and
# keeps it out of the repo's language statistics. It is still tracked, because
# it is the file a user double-clicks.
dist/index.html linguist-generated=true
